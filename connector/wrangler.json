{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "golfans-ito-publish",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "e226ca433a7243a9ba8ee10ecdead4c0" }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://golfans-ito-publish.osaken.workers.dev",
    "AUTOSYNC_ENABLED": "true",
    "AUTOSYNC_HOURS": "8-22"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
